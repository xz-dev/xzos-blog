---
/**
 * 文章标题下的语言版本说明：译文注明译自中文原文，并列出其他语言版本
 */
import { getEntry } from 'astro:content';
import { getBlogCollection, getBlogPrefix } from '../i18n/collections';
import { defaultLang, languages, type Lang } from '../i18n/ui';
import { isMachineTranslation, useTranslations } from '../i18n/utils';
import PixelIcon from './PixelIcon.astro';

interface Props {
  slug: string;
  lang?: Lang;
}

const { slug, lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
// Only machine translations carry the notice; a copy (is_copy) is the original text.
const entry = lang === defaultLang ? undefined : await getEntry(getBlogCollection(lang) as any, slug);
const isTranslation = isMachineTranslation(lang, (entry as any)?.data);

const otherLangs = (Object.keys(languages) as Lang[]).filter((other) => other !== lang);
const versions = [];
for (const other of otherLangs) {
  if (await getEntry(getBlogCollection(other) as any, slug)) {
    versions.push({ lang: other, path: `${getBlogPrefix(other)}/${slug}`, label: languages[other] });
  }
}
---

{(isTranslation || versions.length > 0) && (
  <div class="version-notices">
    {isTranslation && (
      <p>
        <PixelIcon name="translation" class="notice-mark" />
        {t('notice.translatedBefore')}<a href={`${getBlogPrefix(defaultLang)}/${slug}`} hreflang="zh">{t('notice.translatedLink')}</a>{t('notice.translatedAfter')}
      </p>
    )}
    {versions.length > 0 && (
      <p>
        <PixelIcon name="globe" class="notice-mark" />
        {t('notice.alsoIn')}
        {versions.map((version, index) => (
          <>
            {index > 0 && ' / '}
            <a href={version.path} hreflang={version.lang}>{version.label}</a>
          </>
        ))}
      </p>
    )}
  </div>
)}

<style>
  .version-notices {
    margin-bottom: var(--space-4);
    color: var(--secondary);
    font-size: var(--text-meta);
    line-height: var(--leading-meta);
  }

  .version-notices p {
    margin: 0;
  }

  .version-notices a {
    white-space: nowrap;
  }

  /* The pixel mark sits apart from the text it introduces. */
  .version-notices :global(.notice-mark) {
    margin-inline-end: var(--space-2);
  }
</style>
