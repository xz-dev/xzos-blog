---
/**
 * 文章标题下的语言版本说明：译文注明译自哪种语言的原文，并列出其他语言版本
 */
import { getEntry } from 'astro:content';
import { getBlogCollection, getBlogPrefix } from '../i18n/collections';
import { getLangTag, isCopyOfSource, type SourceLang } from '../i18n/seo';
import { defaultLang, languages, type Lang } from '../i18n/ui';
import { isMachineTranslation, useTranslations } from '../i18n/utils';
import PixelIcon from './PixelIcon.astro';

interface Props {
  slug: string;
  lang?: Lang;
  /** The root original's language (getPostSourceLang). */
  source?: SourceLang;
}

const { slug, lang = defaultLang, source = 'zh' } = Astro.props;
const t = useTranslations(lang);
// Only machine translations carry the notice; a copy (is_copy, or a version
// in the original's own language) is the original text.
const entry = lang === defaultLang ? undefined : await getEntry(getBlogCollection(lang) as any, slug);
const data = (entry as any)?.data;
const isTranslation = isMachineTranslation(lang, data) && !isCopyOfSource(lang, source, data);

const otherLangs = (Object.keys(languages) as Lang[]).filter((other) => other !== lang);
const versions = [];
for (const other of otherLangs) {
  if (await getEntry(getBlogCollection(other) as any, slug)) {
    versions.push({ lang: other, hreflang: getLangTag(other, source), path: `${getBlogPrefix(other)}/${slug}/`, label: languages[other] });
  }
}
---

{(isTranslation || versions.length > 0) && (
  <div class="version-notices">
    {isTranslation && (
      <p>
        <PixelIcon name="translation" class="notice-mark" />
        {t('notice.translatedBefore')}<a href={`${getBlogPrefix(defaultLang)}/${slug}/`} hreflang={getLangTag(defaultLang, source)}>{t(source === 'en' ? 'notice.translatedLinkEn' : 'notice.translatedLink')}</a>{t('notice.translatedAfter')}
      </p>
    )}
    {versions.length > 0 && (
      <p>
        <PixelIcon name="globe" class="notice-mark" />
        {t('notice.alsoIn')}
        {versions.map((version, index) => (
          <>
            {index > 0 && ' / '}
            <a href={version.path} hreflang={version.hreflang}>{version.label}</a>
          </>
        ))}
      </p>
    )}
  </div>
)}

<style>
  /* The last line of the article head block, right under the title. */
  .version-notices {
    margin-block: var(--space-2) 0;
    color: var(--secondary);
    font-size: var(--text-meta);
    line-height: var(--leading-meta);
  }

  .version-notices p {
    margin: 0;
  }

  .version-notices a {
    white-space: nowrap;
  }

  /* The pixel mark sits apart from the text it introduces. */
  .version-notices :global(.notice-mark) {
    margin-inline-end: var(--space-2);
  }
</style>
