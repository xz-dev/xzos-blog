---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import FormattedDate from './FormattedDate.astro';

interface Props {
	lang: Lang;
	pubDate: Date;
	pubDateSource?: string;
	updatedDate?: Date;
	updatedDateSource?: string;
	author?: string;
	category?: string;
}

const { lang, pubDate, pubDateSource, updatedDate, updatedDateSource, author, category } = Astro.props;
const t = useTranslations(lang);
---

<div class="post-meta">
	<FormattedDate date={pubDate} source={pubDateSource} />
	{updatedDate && <span>{t('blog.updatedOn')} <FormattedDate date={updatedDate} source={updatedDateSource} /></span>}
	{author && <span>{t('blog.authorLabel')}{author}</span>}
	{category && <span>{t('blog.categoryLabel')}<span class="post-category">{category}</span></span>}
	<slot />
</div>

<style>
	.post-meta {
		display: flex;
		flex-wrap: wrap;
		/* Fields wrap onto the next text line with no gap between rows, so a
		 * wrapped meta line reads as consecutive lines of one block. */
		gap: 0 var(--space-3);
		align-items: center;
		color: var(--secondary);
		font-size: var(--text-meta);
		line-height: var(--leading-meta);
	}
	/* The whole meta line stays dim so the title above it leads; semantic
	 * colours belong to terminal output, not to every list entry. */
</style>
