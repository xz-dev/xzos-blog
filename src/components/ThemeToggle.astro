---
import PixelIcon from './PixelIcon.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const t = useTranslations(getLangFromUrl(Astro.url));
// A plain status-line item: the pixel sun in day, the moon at night, the
// same drawing in both themes. Pressed means night.
---

<button id="theme-toggle" class="menu-item" aria-label={t('theme.toggle')} title={t('theme.toggle')} aria-pressed="false">
	<PixelIcon name="sun" class="theme-sun" />
	<PixelIcon name="moon" class="theme-moon" />
</button>
<script is:inline>
	// The head script has already chosen the theme; match it before first paint
	// so assistive technology never hears a state the page does not show.
	document.getElementById('theme-toggle').setAttribute('aria-pressed', String(document.documentElement.getAttribute('data-theme') === 'tty'));
</script>

<style>
	/* Box, hover and focus come from the shared .menu-item rules; it stays one
	 * menu-item tall and wide so the target is not smaller than a text item. */
	#theme-toggle {
		min-width: var(--menu-item-height);
	}

	/* The icon follows data-theme in CSS, so it is right at first paint. */
	:root[data-theme="tty"] #theme-toggle :global(.theme-sun),
	:root:not([data-theme="tty"]) #theme-toggle :global(.theme-moon) {
		display: none;
	}
</style>

<script>
	// Theme toggle functionality
	const button = document.getElementById('theme-toggle');

	if (button) {
		// The pressed state is night mode. It lives on the button (aria-pressed)
		// and follows data-theme, which the head script, this button and a
		// system colour-scheme change can all set.
		const root = document.documentElement;
		const sync = () => button.setAttribute('aria-pressed', String(root.getAttribute('data-theme') === 'tty'));
		sync();
		new MutationObserver(sync).observe(root, { attributes: true, attributeFilter: ['data-theme'] });
		button.addEventListener('click', () => {
			const currentTheme = root.getAttribute('data-theme') || 'solarized';
			const newTheme = currentTheme === 'solarized' ? 'tty' : 'solarized';

			// The destination's day styles otherwise re-enable fades when leaving TTY.
			root.setAttribute('data-theme-switching', '');
			root.setAttribute('data-theme', newTheme);
			// Commit the new styles while motion is disabled, then restore normal day
			// interactions synchronously. No timer, animation frame or persistent flag.
			void root.offsetHeight;
			root.removeAttribute('data-theme-switching');
			localStorage.setItem('theme', newTheme);
		});
	}
</script>
