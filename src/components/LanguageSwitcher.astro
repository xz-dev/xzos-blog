---
import { languages, type Lang } from '../i18n/ui';
import { getAlternateLanguagePath, getLangFromUrl, useTranslations } from '../i18n/utils';

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
// A status-line field: `lang: zh* en zh-CN`. The visible text is the short
// code; the accessible name starts with the full language name and keeps the
// code, so voice control can still say what it sees.
---

<nav class="language-switcher" aria-label={t('lang.switch')}>
  <span class="menu-label" aria-hidden="true">{t('lang.prefix')}</span>
  {(Object.keys(languages) as Lang[]).map((lang) => {
    const name = `${languages[lang]} (${lang})`;
    return (
      <a
        href={getAlternateLanguagePath(Astro.url, lang)}
        class="lang-link menu-item"
        aria-current={lang === currentLang ? 'page' : undefined}
        aria-label={name}
        title={name}
        hreflang={lang}
        lang={lang}
      >
        {lang}
      </a>
    );
  })}
</nav>

<style>
  .language-switcher {
    display: flex;
    flex-wrap: wrap;
    gap: var(--cell-gap);
    align-items: center;
  }
</style>
