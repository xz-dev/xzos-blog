---
/**
 * 文章目录：像 `tree` 一样画出 h2 / h3 的层级，放在与代码块同样的框里。
 * 窄屏时在文章头部之后；1280px 起在右栏做粘性侧栏，与头部和正文并排（terminal.css 的
 * .article 网格），并以 accent 加尾随 `*` 标出当前阅读的小节。
 * 少于两个标题的文章不画目录（buildTocTree 返回空）。
 */
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { buildTocTree, type Heading } from '../lib/toc-tree';
import PixelIcon from './PixelIcon.astro';
import TocActive from './TocActive.astro';
import TocList from './TocList.astro';

interface Props {
	headings: Heading[];
	lang: Lang;
}

const { headings, lang } = Astro.props;
const t = useTranslations(lang);
const tree = buildTocTree(headings);
---

{tree.length > 0 && (
	<nav class="toc" aria-labelledby="xz-toc-label">
		<details open>
			<summary id="xz-toc-label"><PixelIcon name="chevron-right" class="toc-closed" /><PixelIcon name="chevron-down" class="toc-open" />{t('blog.toc')}</summary>
			<TocList nodes={tree} />
		</details>
		<TocActive />
	</nav>
)}

<style>
	/* The code-block box: --surface, a hairline --border-strong frame and
	 * pre's padding, one blank line above and below. The label line is
	 * `▾ 目录` with a pixel chevron in place of the native marker; hover
	 * colours and underlines it like a link. */
	.toc {
		margin-block: var(--space-4);
		padding: var(--space-3);
		background: var(--surface);
		border: var(--hairline) solid var(--border-strong);
		border-radius: var(--radius);
		line-height: var(--line-height);
		overflow-wrap: anywhere;
	}

	.toc summary {
		display: block;
		list-style: none;
		width: fit-content;
		padding-block: var(--space-1);
		color: var(--foreground);
		cursor: pointer;
	}

	.toc summary:hover {
		color: var(--accent);
		text-decoration: underline;
		text-decoration-thickness: var(--hairline);
		text-underline-offset: var(--underline-offset);
	}

	.toc summary::-webkit-details-marker {
		display: none;
	}

	.toc summary :global(.pixel-icon) {
		margin-inline-end: var(--space-2);
	}

	/* The chevron shows the state: right when closed, down when open. */
	.toc details[open] :global(.toc-closed),
	.toc details:not([open]) :global(.toc-open) {
		display: none;
	}

	/* `tree` output, drawn apart from the titles: each item paints only its own
	 * 3ch column, `├─` or `└─` on its first line and, unless it is the last
	 * sibling, `│` on every line below it, beside its title and its children.
	 * A wrapped title hangs under its text and the column keeps going. The
	 * column takes no height of its own (contain: size) and clips at the item's. */
	.toc :global(ul) {
		list-style: none;
		margin: 0;
	}

	.toc details > :global(ul) {
		margin-block-start: var(--space-2);
	}

	.toc :global(li) {
		display: grid;
		grid-template-columns: 3ch minmax(0, 1fr);
	}

	.toc :global(li)::before {
		/* shortcut: 99 `│` lines per item; raise it if one section's title and children ever run longer. */
		content: "├─\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│\A│" / "";
		grid-column: 1;
		grid-row: 1 / span 2;
		color: var(--secondary);
		white-space: pre;
		overflow: hidden;
		contain: size;
	}

	.toc :global(li:last-child)::before {
		content: "└─" / "";
	}

	.toc :global(li > *) {
		grid-column: 2;
	}

	.toc :global(a) {
		justify-self: start;
	}

	/* The section in view: accent and a trailing `*`, as the status line marks
	 * its current item. Every link reserves the `*` cell, so marking one never
	 * rewraps its title. */
	.toc :global(a)::after {
		content: "*";
		content: "*" / "";
		visibility: hidden;
	}

	.toc :global(a[aria-current]) {
		color: var(--accent);
	}

	.toc :global(a[aria-current])::after {
		visibility: visible;
	}
</style>
