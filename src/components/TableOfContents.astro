---
/**
 * 文章目录：像 `tree` 一样画出 h2 / h3 的层级，放在与代码块同样的框里。
 * 窄屏时在文章头部之后；1280px 起在正文右侧做粘性侧栏（terminal.css 的
 * .article 网格），并以 accent 加尾随 `*` 标出当前阅读的小节。
 * 少于两个标题的文章不画目录（buildTocTree 返回空）。
 */
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { buildTocTree, type Heading } from '../lib/toc-tree';
import PixelIcon from './PixelIcon.astro';
import TocList from './TocList.astro';

interface Props {
	headings: Heading[];
	lang: Lang;
}

const { headings, lang } = Astro.props;
const t = useTranslations(lang);
const tree = buildTocTree(headings);
---

{tree.length > 0 && (
	<nav class="toc" aria-labelledby="toc-label">
		<details open>
			<summary id="toc-label"><PixelIcon name="chevron-right" class="toc-closed" /><PixelIcon name="chevron-down" class="toc-open" />{t('blog.toc')}</summary>
			<TocList nodes={tree} />
		</details>
	</nav>
)}

<script>
	// Marks the section being read: the last heading above the top 30% of the
	// viewport. Without script the contents stay a plain list of links.
	const links = new Map<string, HTMLAnchorElement>();
	for (const link of document.querySelectorAll<HTMLAnchorElement>('.toc a[href^="#"]')) {
		links.set(decodeURIComponent(link.hash.slice(1)), link);
	}
	const headings = [...document.querySelectorAll<HTMLElement>('.article-body :is(h2, h3)[id]')].filter((heading) => links.has(heading.id));
	if (headings.length > 0 && 'IntersectionObserver' in window) {
		let current: HTMLAnchorElement | undefined;
		const update = () => {
			const line = window.innerHeight * 0.3;
			let active: HTMLElement | undefined;
			for (const heading of headings) {
				if (heading.getBoundingClientRect().top <= line) active = heading;
				else break;
			}
			const next = active && links.get(active.id);
			if (next === current) return;
			current?.removeAttribute('aria-current');
			next?.setAttribute('aria-current', 'location');
			current = next;
		};
		const observer = new IntersectionObserver(update, { rootMargin: '0px 0px -70% 0px' });
		for (const heading of headings) observer.observe(heading);
		update();
	}
</script>

<style>
	/* The code-block box: --surface, a hairline --border-strong frame and
	 * pre's padding, one blank line above and below. The label line is
	 * `▾ 目录` with a pixel chevron in place of the native marker; hover
	 * colours and underlines it like a link. */
	.toc {
		margin-block: var(--space-4);
		padding: var(--space-3);
		background: var(--surface);
		border: var(--hairline) solid var(--border-strong);
		border-radius: var(--radius);
		line-height: var(--line-height);
		overflow-wrap: anywhere;
	}

	.toc summary {
		display: block;
		list-style: none;
		width: fit-content;
		color: var(--foreground);
		cursor: pointer;
	}

	.toc summary:hover {
		color: var(--accent);
		text-decoration: underline;
		text-decoration-thickness: var(--hairline);
		text-underline-offset: var(--underline-offset);
	}

	.toc summary::-webkit-details-marker {
		display: none;
	}

	.toc summary :global(.pixel-icon) {
		margin-inline-end: var(--space-2);
	}

	/* The chevron shows the state: right when closed, down when open. */
	.toc details[open] :global(.toc-closed),
	.toc details:not([open]) :global(.toc-open) {
		display: none;
	}

	/* `tree` output: one row per heading, the branch prefix in --secondary and
	 * kept as typed (white-space: pre); a wrapped title hangs under its text. */
	.toc :global(ul) {
		list-style: none;
		margin: 0;
	}

	.toc details > :global(ul) {
		margin-block-start: var(--space-2);
	}

	.toc :global(.toc-row) {
		display: flex;
	}

	.toc :global(.toc-branch) {
		flex: none;
		color: var(--secondary);
		white-space: pre;
	}

	.toc :global(a) {
		min-width: 0;
	}

	/* The section in view: accent and a trailing `*`, as the status line marks
	 * its current item. Every link reserves the `*` cell, so marking one never
	 * rewraps its title. */
	.toc :global(a)::after {
		content: "*";
		content: "*" / "";
		visibility: hidden;
	}

	.toc :global(a[aria-current]) {
		color: var(--accent);
	}

	.toc :global(a[aria-current])::after {
		visibility: visible;
	}
</style>
