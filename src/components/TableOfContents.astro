---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import PixelIcon from './PixelIcon.astro';

interface Props {
	headings: { depth: number; slug: string; text: string }[];
	lang: Lang;
}

const { headings, lang } = Astro.props;
const t = useTranslations(lang);
const entries = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

{entries.length > 0 && (
	<nav class="toc">
		<details open>
			<summary class="control"><PixelIcon name="chevron-right" class="tty-toc-closed" /><PixelIcon name="chevron-down" class="tty-toc-open" />{t('blog.toc')}</summary>
			<ul>
				{entries.map((heading) => (
					<li class:list={{ sub: heading.depth === 3 }}>
						<a href={`#${heading.slug}`}>{heading.text}</a>
					</li>
				))}
			</ul>
		</details>
	</nav>
)}

<style>
	.toc {
		margin-bottom: var(--space-5);
	}

	/* A summary keeps its disclosure marker only as a list item. The marker
	 * sits outside the control's box, on the page, so it keeps the accent
	 * instead of inheriting the hovered control's page-coloured text. */
	.toc summary {
		display: list-item;
		width: fit-content;
		padding-block: var(--space-2);
	}

	.toc summary::marker {
		color: var(--accent);
	}

	.toc ul {
		list-style: none;
		margin: var(--space-2) 0 0 var(--space-4);
	}

	.toc li {
		margin: var(--space-1) 0;
	}

	.toc .sub {
		padding-inline-start: var(--space-4);
	}
</style>
