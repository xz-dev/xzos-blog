---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import PixelIcon from './PixelIcon.astro';

interface Props {
	headings: { depth: number; slug: string; text: string }[];
	lang: Lang;
}

const { headings, lang } = Astro.props;
const t = useTranslations(lang);
const entries = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

{entries.length > 0 && (
	<nav class="toc">
		<details open>
			<summary><PixelIcon name="chevron-right" class="tty-toc-closed" /><PixelIcon name="chevron-down" class="tty-toc-open" />{t('blog.toc')}</summary>
			<ul>
				{entries.map((heading) => (
					<li class:list={{ sub: heading.depth === 3 }}>
						<a href={`#${heading.slug}`}>{heading.text}</a>
					</li>
				))}
			</ul>
		</details>
	</nav>
)}

<style>
	.toc {
		margin-block-end: var(--space-5);
	}

	/* A plain text line, `▸ 目录` or `▾ 目录`, the same in both themes: no box,
	 * fill or bevel. Day draws the native disclosure marker, night a pixel
	 * chevron (tty-pixel-icons.css). Hover colours and underlines it like a
	 * link; the block padding keeps a 32px target and room for the focus ring. */
	.toc summary {
		display: list-item;
		width: fit-content;
		padding-block: var(--space-1);
		color: var(--foreground);
		cursor: pointer;
	}

	.toc summary:hover {
		color: var(--accent);
		text-decoration: underline;
		text-decoration-thickness: var(--hairline);
		text-underline-offset: var(--underline-offset);
	}

	.toc summary::marker {
		color: var(--accent);
	}

	.toc ul {
		list-style: none;
		margin-block: var(--space-2) 0;
		margin-inline: var(--space-4) 0;
	}

	.toc li {
		margin: var(--space-1) 0;
	}

	.toc .sub {
		padding-inline-start: var(--space-4);
	}
</style>
