---
import { SOCIAL_LINKS } from '../consts';
import PixelIcon from './PixelIcon.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const t = useTranslations(getLangFromUrl(Astro.url));
const today = new Date();
---

<footer>
	<div class="copyright">
		&copy; {today.getFullYear()} xz-dev.
		<a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="license noopener noreferrer">CC BY 4.0</a>
		<a href="/rss.xml" type="application/rss+xml">RSS</a>
		<a href="https://github.com/xz-dev/xzos-blog" target="_blank" rel="noopener noreferrer">{t('footer.source')}</a>
	</div>
	<div class="social-links">
		<a class="menu-item menu-item-icon" href={SOCIAL_LINKS.mastodon} target="_blank">
			<span class="sr-only">{t('social.mastodon')}</span>
			<PixelIcon name="mastodon" />
		</a>
		<a class="menu-item menu-item-icon" href={SOCIAL_LINKS.github} target="_blank">
			<span class="sr-only">{t('social.github')}</span>
			<PixelIcon name="github" />
		</a>
		<a class="menu-item menu-item-icon" href={SOCIAL_LINKS.stackOverflow} target="_blank">
			<span class="sr-only">{t('social.stackOverflow')}</span>
			<PixelIcon name="stack-overflow" />
		</a>
	</div>
</footer>
<style>
	footer {
		padding: var(--space-6) var(--space-3);
		background: var(--background);
		color: var(--secondary);
		text-align: center;
		border-block-start: var(--rule) solid var(--accent);
		margin-top: var(--space-7);
	}

	.copyright {
		margin-bottom: var(--space-3);
		font-size: var(--text-meta);
		line-height: var(--leading-meta);
	}

	.copyright a {
		margin-inline-start: var(--space-2);
	}

	.social-links {
		display: flex;
		justify-content: center;
		gap: var(--space-2);
	}
</style>
