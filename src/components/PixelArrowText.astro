---
import { splitPixelArrowText } from '../lib/pixel-icons';
import PixelIcon from './PixelIcon.astro';

interface Props {
	text: string;
}
const { text } = Astro.props;
// The label stays text; only the ← and → arrows become pixel marks, in both themes.
---
{splitPixelArrowText(text).map((part) => part.icon ? <PixelIcon name={part.icon} /> : part.text)}
