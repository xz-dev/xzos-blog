---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

type ThumbnailPost = {
	data: {
		title: string;
		heroImage?: ImageMetadata;
	};
	body?: string;
};

interface Props {
	post: ThumbnailPost;
}

type Thumbnail =
	| { type: 'astro'; src: ImageMetadata }
	| { type: 'url'; src: string };

const { post } = Astro.props;

// Only a real picture becomes a thumbnail: the hero image, else the first
// image in the body. A post without one shows no thumbnail.
function getPostImage(post: ThumbnailPost): Thumbnail | null {
	if (post.data.heroImage) {
		return { type: 'astro', src: post.data.heroImage };
	}

	if (post.body) {
		// Markdown images: ![alt](url)
		const mdMatch = post.body.match(/!\[.*?\]\((.*?)\)/);
		if (mdMatch && mdMatch[1]) {
			return { type: 'url', src: mdMatch[1] };
		}
		// HTML images: <img src="url">
		const htmlMatch = post.body.match(/<img[^>]+src=["'](.*?)["']/);
		if (htmlMatch && htmlMatch[1]) {
			return { type: 'url', src: htmlMatch[1] };
		}
	}

	return null;
}

const thumbnail = getPostImage(post);
---

{thumbnail && (
	<div class="post-thumbnail">
		{thumbnail.type === 'astro' ? (
			<Image width={128} height={128} src={thumbnail.src} alt="" class="thumbnail-image" />
		) : (
			<img width={128} height={128} src={thumbnail.src} alt="" class="thumbnail-image" />
		)}
	</div>
)}

<style>
	/* A small square beside the list entry: no radius, shadow or hover effect. */
	.post-thumbnail {
		flex: none;
		width: var(--thumb-size);
		height: var(--thumb-size);
	}
	.thumbnail-image {
		width: 100%;
		height: 100%;
		margin: 0;
		object-fit: cover;
		border-radius: 0;
	}
</style>
