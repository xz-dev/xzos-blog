---
import { Image } from 'astro:assets';
import { getPostImage, type ThumbnailPost } from '../lib/post-image';

interface Props {
	post: ThumbnailPost;
	href: string;
}

const { post, href } = Astro.props;
const thumbnail = getPostImage(post);
---

{/* The picture opens the post too. The title beside it is the same link
   and carries the name, so this one stays out of the tab order and the
   accessibility tree instead of repeating it. */}
{thumbnail && (
	<a class="post-thumbnail" href={href} tabindex="-1" aria-hidden="true">
		{thumbnail.type === 'astro' ? (
			<Image width={128} height={128} src={thumbnail.src} alt="" class="thumbnail-image" />
		) : (
			<img width={128} height={128} src={thumbnail.src} alt="" class="thumbnail-image" />
		)}
	</a>
)}

<style>
	/* A small square beside the list entry: no radius, shadow or hover effect. */
	.post-thumbnail {
		display: block;
		width: var(--thumb-size);
		height: var(--thumb-size);
	}
	.thumbnail-image {
		width: 100%;
		height: 100%;
		margin: 0;
		object-fit: cover;
		border-radius: var(--radius);
	}
</style>
