---
/**
 * 块光标：一个完整的 Unifont 字格（U+2588），跟在提示符后面。
 * 只有 blink 为真、且页面脚本已显示暂停控件（祖先带 data-pausable）时才闪烁（首页，满足 WCAG 2.2.2）；
 * 没有 JS 或在其他页面，光标都是静止的。
 */
interface Props {
	blink?: boolean;
}

const { blink = false } = Astro.props;
---

<span class="cursor" data-blink={blink ? '' : undefined} aria-hidden="true">█</span>
