---
/**
 * 两列对齐的命令输出（`left  right`），如 `ls -t` 的日期与标题、`ls ~/friends` 的名字与主机。
 * 左列宽度取最长一项的终端字宽（cellWidth，宽字符算 2ch），所以左列从不换行；右列占满余下宽度，在列内换行。
 * 有链接的格子用正文色，纯文本格子用 --secondary。stack 为真时，右列也不换行：
 * 一行放不下最长的 `left  right` 时，整张表一起改为右列另起一行、缩进 2ch。
 */
import { cellWidth } from '../../lib/term-width';

interface Cell {
	text: string;
	href?: string;
	/** 新标签页打开的外部链接。 */
	external?: boolean;
	/** 有此值时渲染为 <time datetime>。 */
	datetime?: string;
}

interface Props {
	rows: { left: Cell; right: Cell }[];
	stack?: boolean;
}

const { rows, stack = false } = Astro.props;
const widest = (cells: Cell[]) => Math.max(0, ...cells.map((cell) => cellWidth(cell.text)));
const left = widest(rows.map((row) => row.left));
const right = widest(rows.map((row) => row.right));
---

<ul class:list={['term-output', stack && 'term-output-stack']} style={`--term-left: ${left}ch; --term-right: ${right}ch`}>
	{rows.map(({ left, right }) => (
		<li>
			{[left, right].map((cell) =>
				cell.href ? (
					<a href={cell.href} {...(cell.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>{cell.text}</a>
				) : cell.datetime ? (
					<time datetime={cell.datetime}>{cell.text}</time>
				) : (
					<span>{cell.text}</span>
				),
			)}
		</li>
	))}
</ul>
