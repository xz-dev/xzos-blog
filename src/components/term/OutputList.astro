---
/**
 * 两列对齐的命令输出（`left  right`），如 `ls -t` 的日期与标题、`ls ~/friends` 的名字与主机。
 * 左列宽度取最长一项的终端字宽（cellWidth，宽字符算 2ch），所以左列从不换行；右列占满余下宽度，在列内换行。
 * 每格是一个 .term-cell，列宽在格子上，里面的链接只有文字那么宽，所以列里的空白处不是链接。
 * leftWidth 给出时左列用这个宽度（几个列表共用一条对齐线），比它长的项在列内换行。
 * 链接（站内与外链）用正文色，日期用 --term-date，其余纯文本格子用 --secondary；
 * role 为 command 的格子首个词是命令名（--term-prompt），role 为 text 的格子用正文色。stack 为真时，右列也不换行：
 * 一行放不下最长的 `left  right` 时，整张表一起改为右列另起一行、缩进 2ch。
 */
import { splitName } from '../../lib/term-command';
import { cellWidth } from '../../lib/term-width';
import type { Cell } from '../../lib/xzsh';

interface Props {
	rows: { left: Cell; right: Cell }[];
	stack?: boolean;
	/** 左列宽度（终端字宽）；省略时取最长一项。 */
	leftWidth?: number;
	/** 列表的可访问名称：画面上给它命名的提示符对读屏器隐藏。 */
	label?: string;
}

const { rows, stack = false, label, leftWidth } = Astro.props;
const widest = (cells: Cell[]) => Math.max(0, ...cells.map((cell) => cellWidth(cell.text)));
const left = leftWidth ?? widest(rows.map((row) => row.left));
const right = widest(rows.map((row) => row.right));
---

<ul class:list={['term-output', stack && 'term-output-stack']} style={`--term-left: ${left}ch; --term-right: ${right}ch`} aria-label={label}>
	{rows.map(({ left, right }) => (
		<li>
			{[left, right].map((cell) => (
				<span class:list={['term-cell', cell.role === 'text' && 'term-cell-text']}>
					{cell.href ? (
						cell.external ? (
							<a href={cell.href} target="_blank" rel="noopener noreferrer">{cell.text}</a>
						) : (
							<a href={cell.href}>{cell.text}</a>
						)
					) : cell.datetime ? (
						<time class="term-date" datetime={cell.datetime}>{cell.text}</time>
					) : cell.role === 'command' ? (
						<><span class="term-name">{splitName(cell.text)[0]}</span>{splitName(cell.text)[1]}</>
					) : (
						cell.text
					)}
				</span>
			))}
		</li>
	))}
</ul>
