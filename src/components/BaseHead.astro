---
// Import the terminal theme (contains all base styles)
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/terminal.css';
import '../styles/tty.css';
import type { ImageMetadata } from 'astro';
import { SITE_TITLE } from '../consts';
import { getAlternates, getCanonicalPath, splitLocalePath, type PageVersions } from '../i18n/seo';
import { getKnownSocialImageMetadata } from '../lib/social-preview';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata | string;
	/** The page's language versions; canonical and hreflang follow the rule in i18n/seo.ts. */
	versions?: PageVersions;
	/** An error page: noindex, with no canonical and no alternates. */
	noindex?: boolean;
	/** A post's dates: og:type becomes article. */
	article?: { published: Date; modified?: Date };
}

const { title, description, image = '/og/default.png', versions, noindex = false, article } = Astro.props;
const { lang: currentLang, path } = splitLocalePath(Astro.url.pathname);
const canonicalURL = noindex ? undefined : new URL(getCanonicalPath(currentLang, path, versions), Astro.site);
const alternates = noindex ? [] : getAlternates(path, versions).map(({ hreflang, path: href }) => ({
	hreflang,
	url: new URL(href, Astro.site),
}));
const isImageMetadata = typeof image !== 'string';
const imageSrc = isImageMetadata ? image.src : image;
const imageURL = new URL(imageSrc, Astro.site || Astro.url);
const imageMetadata = getKnownSocialImageMetadata(image);
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<!-- The site draws its own day and night themes: Dark Reader leaves it alone,
     and native controls and scrollbars follow the theme's color-scheme
     (tokens.css sets light on day, dark on night). -->
<meta name="darkreader-lock" />
<meta name="color-scheme" content="light dark" />
<!-- Unifont serves both themes. Preload the subsets the first paint needs, so
     text does not paint in the fallback monospace and then reflow: Latin on
     every page, and common CJK (punctuation and the level-1 characters) on the
     Chinese pages. The other subsets load on demand through unicode-range. -->
<link rel="preload" href="/fonts/unifont-18.0.01-latin.woff2" as="font" type="font/woff2" crossorigin />
{currentLang !== 'en' && <link rel="preload" href="/fonts/unifont-18.0.01-cjk-common.woff2" as="font" type="font/woff2" crossorigin />}
<link id="site-favicon" rel="icon" type="image/png" href="/dotted_circle.png" sizes="192x192" />
<link rel="apple-touch-icon" href="/dotted_circle.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL and hreflang alternates (rule in i18n/seo.ts) -->
{noindex && <meta name="robots" content="noindex" />}
{canonicalURL && <link rel="canonical" href={canonicalURL} />}
{alternates.map(({ hreflang, url }) => (
	<link rel="alternate" hreflang={hreflang} href={url} />
))}

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={article ? 'article' : 'website'} />
{canonicalURL && <meta property="og:url" content={canonicalURL} />}
{article && <meta property="article:published_time" content={article.published.toISOString()} />}
{article?.modified && <meta property="article:modified_time" content={article.modified.toISOString()} />}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta property="og:image:alt" content={title} />
{imageMetadata && <meta property="og:image:width" content={String(imageMetadata.width)} />}
{imageMetadata && <meta property="og:image:height" content={String(imageMetadata.height)} />}
{imageMetadata && <meta property="og:image:type" content={imageMetadata.type} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
{canonicalURL && <meta name="twitter:url" content={canonicalURL} />}
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />
<meta name="twitter:image:alt" content={title} />

<!-- Theme Detection Script (runs before page renders to prevent flash) -->
<script is:inline>
	// Detect and apply theme before page renders
	(function() {
		function getTheme() {
			// Check localStorage first
			const stored = localStorage.getItem('theme');
			if (stored) return stored;

			// Fall back to system preference
			if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
				return 'tty';
			}

			return 'solarized';
		}

		// Apply theme immediately
		const theme = getTheme();
		document.documentElement.setAttribute('data-theme', theme);

		// One same-origin hand-drawn grid for both page branding and night favicon.
		// Restore every original day attribute when switching back to Solarized.
		const favicon = document.getElementById('site-favicon');
		function syncFavicon() {
			if (!favicon) return;
			const isNight = document.documentElement.getAttribute('data-theme') === 'tty';
			favicon.setAttribute('type', isNight ? 'image/svg+xml' : 'image/png');
			favicon.setAttribute('sizes', isNight ? 'any' : '192x192');
			favicon.setAttribute('href', isNight ? '/favicon-tty.svg' : '/dotted_circle.png');
		}
		syncFavicon();
		new MutationObserver(syncFavicon).observe(document.documentElement, {
			attributes: true,
			attributeFilter: ['data-theme'],
		});

		// Listen for system theme changes
		if (window.matchMedia) {
			window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
				if (!localStorage.getItem('theme')) {
					document.documentElement.setAttribute('data-theme', e.matches ? 'tty' : 'solarized');
				}
			});
		}
	})();
</script>
