---
/**
 * 目录树的一层：真正嵌套的 <ul>，子标题递归画在同一项里。
 * `tree` 的连线不在内容里，由 TableOfContents.astro 的 CSS 逐项绘制。
 */
import type { TocNode } from '../lib/toc-tree';

interface Props {
	nodes: TocNode[];
}

const { nodes } = Astro.props;
---

<ul>
	{nodes.map((node) => (
		<li>
			<a href={`#${node.slug}`}>{node.text}</a>
			{node.children.length > 0 && <Astro.self nodes={node.children} />}
		</li>
	))}
</ul>
