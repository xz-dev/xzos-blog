---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import LanguageVersionNotice from '../components/LanguageVersionNotice.astro';
import PageFrame from '../components/PageFrame.astro';
import PostMeta from '../components/PostMeta.astro';
import Remark42Comments from '../components/Remark42Comments.astro';
import TableOfContents from '../components/TableOfContents.astro';
import type { Lang } from '../i18n/ui';

type Props = CollectionEntry<'blog'>['data'] & {
	headings?: { depth: number; slug: string; text: string }[];
	ogImage?: ImageMetadata | string;
	lang?: Lang;
	slug?: string;
};

const { title, description, pubDate, updatedDate, pubDateSource, updatedDateSource, heroImage, headings = [], ogImage, lang = 'zh', slug } = Astro.props;
const postSlug = slug || Astro.url.pathname.split('/').filter(Boolean).pop() || '';
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={title} description={description} image={ogImage} />
		<style>
			:global(.page-frame-article .post-meta) {
				margin-bottom: var(--space-2);
			}
			.hero-image {
				margin: 0 auto var(--space-4);
			}
		</style>
	</head>

	<body>
		<Header />
		<PageFrame title={title} pattern="article">
			{heroImage && <Image slot="hero" class="hero-image" width={1020} height={510} src={heroImage} alt="" />}
			<PostMeta slot="meta" lang={lang} pubDate={pubDate} pubDateSource={pubDateSource} updatedDate={updatedDate} updatedDateSource={updatedDateSource} />
			<LanguageVersionNotice slug={postSlug} lang={lang} />
			<TableOfContents headings={headings} lang={lang} />
			<slot />
			<hr />
			<Remark42Comments lang={lang} />
		</PageFrame>
		<Footer />
	</body>
</html>
