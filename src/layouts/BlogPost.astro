---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import LanguageVersionNotice from '../components/LanguageVersionNotice.astro';
import PostMeta from '../components/PostMeta.astro';
import Remark42Comments from '../components/Remark42Comments.astro';
import TableOfContents from '../components/TableOfContents.astro';
import type { Lang } from '../i18n/ui';

type Props = CollectionEntry<'blog'>['data'] & {
	headings?: { depth: number; slug: string; text: string }[];
	ogImage?: ImageMetadata | string;
	lang?: Lang;
	slug?: string;
};

const { title, description, pubDate, updatedDate, pubDateSource, updatedDateSource, heroImage, headings = [], ogImage, lang = 'zh', slug } = Astro.props;
const postSlug = slug || Astro.url.pathname.split('/').filter(Boolean).pop() || '';
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={title} description={description} image={ogImage} />
		<style>
			.post-frame {
				width: var(--prose-width);
				max-width: calc(100% - var(--space-5));
				margin: auto;
				padding: var(--space-3);
			}
			.post-frame :global(.post-meta) {
				margin-bottom: var(--space-2);
			}
			.hero-image {
				margin: 0 auto var(--space-4);
			}
		</style>
	</head>

	<body>
		<Header />
		<main class="post-frame">
			{heroImage && <Image class="hero-image" width={1020} height={510} src={heroImage} alt="" />}
			<article class="prose">
				<PostMeta lang={lang} pubDate={pubDate} pubDateSource={pubDateSource} updatedDate={updatedDate} updatedDateSource={updatedDateSource} />
				<h1 class="page-title">{title}</h1>
				<LanguageVersionNotice slug={postSlug} lang={lang} />
				<TableOfContents headings={headings} lang={lang} />
				<slot />
				<hr />
				<Remark42Comments lang={lang} />
			</article>
		</main>
		<Footer />
	</body>
</html>
