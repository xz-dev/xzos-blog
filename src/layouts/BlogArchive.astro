---
/**
 * 博客归档页 - 紧凑列表（缩略图、标题、一行元信息），条目间距与分隔线见 terminal.css 的 .post-item
 * 用于 /blog/, /en/blog/, /zh-CN/blog/
 */
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PageFrame from '../components/PageFrame.astro';
import PostMeta from '../components/PostMeta.astro';
import PostThumbnail from '../components/PostThumbnail.astro';
import { getBlogCollection, getBlogPrefix, getHtmlLang } from '../i18n/collections';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { SITE_TITLE } from '../consts';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const htmlLang = getHtmlLang(lang);
const blogPrefix = getBlogPrefix(lang);
const collectionName = getBlogCollection(lang);

const posts = (await getCollection(collectionName as any)).sort(
	(a: any, b: any) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang={htmlLang}>
	<head>
		<BaseHead title={`${t('blog.heading')} - ${SITE_TITLE}`} description={t('meta.blogDescription')} />
		<style>
			/* Every entry reserves the thumbnail column, so all titles share one
			 * left edge with or without a picture. The date breaks between day
			 * and clock (FormattedDate), so the text fits beside it at 320px. */
			.post-item {
				display: grid;
				grid-template-columns: var(--thumb-size) minmax(0, 1fr);
				column-gap: var(--space-3);
				align-items: start;
			}
			.post-text {
				grid-column: 2;
			}
		</style>
	</head>
	<body>
		<Header />
		<PageFrame title={t('blog.heading')} pattern="list">
			<ul class="post-list post-list-compact">
				{
					posts.map((post: any) => (
						<li class="post-item">
							<PostThumbnail post={post} href={`${blogPrefix}/${post.id}/`} />
							<div class="post-text">
								<h2 class="post-title">
									<a href={`${blogPrefix}/${post.id}/`}>{post.data.title}</a>
								</h2>
								<PostMeta lang={lang} pubDate={post.data.pubDate} pubDateSource={post.data.pubDateSource} author={post.data.author} category={post.data.category} />
							</div>
						</li>
					))
				}
			</ul>
		</PageFrame>
		<Footer />
	</body>
</html>
