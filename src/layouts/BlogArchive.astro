---
/**
 * 博客归档页 - 与首页相同的纯列表（标题、一行元信息）
 * 用于 /blog/, /en/blog/, /zh-CN/blog/
 */
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PageFrame from '../components/PageFrame.astro';
import PostMeta from '../components/PostMeta.astro';
import PostThumbnail from '../components/PostThumbnail.astro';
import { getBlogCollection, getBlogPrefix, getHtmlLang } from '../i18n/collections';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const htmlLang = getHtmlLang(lang);
const blogPrefix = getBlogPrefix(lang);
const collectionName = getBlogCollection(lang);

const posts = (await getCollection(collectionName as any)).sort(
	(a: any, b: any) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang={htmlLang}>
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			/* The text wraps below the thumbnail only when the two do not fit
			 * side by side (a 320px phone with a long date). */
			.post-item {
				display: flex;
				flex-wrap: wrap;
				gap: var(--space-3);
				align-items: flex-start;
				margin-bottom: var(--space-4);
				padding-bottom: var(--space-4);
			}
			.post-text {
				flex: 1 1 calc(var(--thumb-size) * 3);
				min-width: 0;
			}
			.post-title {
				margin-bottom: var(--space-2);
			}
		</style>
	</head>
	<body>
		<Header />
		<PageFrame title={t('blog.heading')}>
			<ul class="post-list">
				{
					posts.map((post: any) => (
						<li class="post-item">
							<PostThumbnail post={post} />
							<div class="post-text">
								<h2 class="post-title">
									<a href={`${blogPrefix}/${post.id}/`}>{post.data.title}</a>
								</h2>
								<PostMeta lang={lang} pubDate={post.data.pubDate} pubDateSource={post.data.pubDateSource} author={post.data.author} category={post.data.category} />
							</div>
						</li>
					))
				}
			</ul>
		</PageFrame>
		<Footer />
	</body>
</html>
