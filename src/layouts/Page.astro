---
/**
 * 静态页面布局（about 等），画成一段终端会话：`$ cat ~/<slug>.md`，页面内容作为命令输出，
 * 最后是带块光标的提示符。h1 只对读屏器可见，提示符行就是画面上的标题。
 * 用于 /about, /en/about, /zh-CN/about
 */
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PageFrame from '../components/PageFrame.astro';
import Prompt from '../components/term/Prompt.astro';
import { getHtmlLang, getPagesCollection } from '../i18n/collections';
import { locales } from '../i18n/seo';
import { defaultLang, navItems, type Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { SITE_TITLE } from '../consts';
import { getEntry, render } from 'astro:content';

interface Props {
	lang: Lang;
	slug: string;
}

const { lang, slug } = Astro.props;
const t = useTranslations(lang);
const htmlLang = getHtmlLang(lang);
const collectionName = getPagesCollection(lang);

const page = await getEntry(collectionName as any, slug);
if (!page) {
	throw new Error(`Page "${slug}" not found in collection "${collectionName}"`);
}

const { Content } = await render(page);

// The <title> uses the menu label (关于 / About); every locale's frontmatter
// title is the English "Introduction". A locale's verbatim copy (is_copy)
// is not an alternate and points its canonical at the root page.
const navItem = navItems.find((item) => item.path === `/${slug}/`);
const headTitle = `${navItem ? t(navItem.key) : page.data.title} - ${SITE_TITLE}`;
const copies: Lang[] = [];
for (const locale of locales) {
	if (locale === defaultLang) continue;
	const version = await getEntry(getPagesCollection(locale) as any, slug);
	if ((version as any)?.data.is_copy) copies.push(locale);
}
---

<!doctype html>
<html lang={htmlLang}>
	<head>
		<BaseHead title={headTitle} description={page.data.description} versions={{ copies }} />
	</head>
	<body>
		<Header />
		<PageFrame title={page.data.title} hideTitle>
			<Prompt command={t('term.cat', { file: `${slug}.md` })} />
			<article class="prose term-text">
				<Content />
			</article>
			<Prompt cursor />
		</PageFrame>
		<Footer />
	</body>
</html>
