---
/**
 * 静态页面布局（about 等），画成一段终端会话：`$ cat ~/<slug>.md`，页面内容作为命令输出，
 * 最后是带块光标的提示符。h1 只对读屏器可见，提示符行就是画面上的标题。
 * 用于 /about, /en/about, /zh-CN/about
 */
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PageFrame from '../components/PageFrame.astro';
import Prompt from '../components/term/Prompt.astro';
import { getHtmlLang, getPagesCollection } from '../i18n/collections';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { SITE_TITLE } from '../consts';
import { getEntry, render } from 'astro:content';

interface Props {
	lang: Lang;
	slug: string;
}

const { lang, slug } = Astro.props;
const t = useTranslations(lang);
const htmlLang = getHtmlLang(lang);
const collectionName = getPagesCollection(lang);

const page = await getEntry(collectionName as any, slug);
if (!page) {
	throw new Error(`Page "${slug}" not found in collection "${collectionName}"`);
}

const { Content } = await render(page);
---

<!doctype html>
<html lang={htmlLang}>
	<head>
		<BaseHead title={`${page.data.title} - ${SITE_TITLE}`} description={page.data.description} />
	</head>
	<body>
		<Header />
		<PageFrame title={page.data.title} hideTitle>
			<Prompt command={t('term.cat', { file: `${slug}.md` })} />
			<article class="prose term-text">
				<Content />
			</article>
			<Prompt cursor />
		</PageFrame>
		<Footer />
	</body>
</html>
