---
/**
 * 首页与分页列表：标题、摘要、元信息行，底部分页
 * 用于 /, /en/, /zh-CN/ 与 /page/N, /en/page/N, /zh-CN/page/N
 */
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PageFrame from '../components/PageFrame.astro';
import PostMeta from '../components/PostMeta.astro';
import PixelArrowText from '../components/PixelArrowText.astro';
import { getBlogPrefix, getHomePath, getHtmlLang, getPagePrefix } from '../i18n/collections';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

interface PostWithExcerpt {
	post: any;
	excerpt: { html: string; hasMore: boolean };
}

interface Props {
	lang: Lang;
	currentPage: number;
	totalPages: number;
	posts: PostWithExcerpt[];
}

const { lang, currentPage, totalPages, posts } = Astro.props;
const t = useTranslations(lang);
const htmlLang = getHtmlLang(lang);
const blogPrefix = getBlogPrefix(lang);
const pagePrefix = getPagePrefix(lang);
const homePath = getHomePath(lang);

const pageTitle = currentPage === 1
	? `${SITE_TITLE} - ${t('site.tagline')}`
	: t('pagination.pageTitle', { title: SITE_TITLE, page: currentPage.toString() });

// Pagination shows the first and last page and the current page's
// neighbours; a gap between two shown numbers becomes an ellipsis.
const shownPages = [...new Set([1, currentPage - 1, currentPage, currentPage + 1, totalPages])]
	.filter((page) => page >= 1 && page <= totalPages)
	.sort((a, b) => a - b);
const pageHref = (page: number) => (page === 1 ? homePath : `${pagePrefix}/${page}/`);
---

<!doctype html>
<html lang={htmlLang}>
	<head>
		<BaseHead title={pageTitle} description={SITE_DESCRIPTION} />
		<style>
			.post-excerpt {
				color: var(--foreground);
				line-height: var(--leading-prose);
				margin: var(--space-3) 0;
			}
			.post-excerpt :global(blockquote) {
				margin: var(--space-3) 0;
			}
			/* Excerpt headings start at h3 (src/lib/excerpt.ts) and all read
			 * as one sub-heading size under the entry title. */
			.post-excerpt :global(h3),
			.post-excerpt :global(h4),
			.post-excerpt :global(h5),
			.post-excerpt :global(h6) {
				font-size: var(--text-h3);
				line-height: var(--leading-h3);
				margin: var(--space-3) 0 var(--space-2) 0;
			}
			.post-excerpt :global(p) {
				margin: var(--space-2) 0;
			}
			.post-excerpt :global(ul),
			.post-excerpt :global(ol) {
				margin: var(--space-2) 0;
				padding-inline-start: var(--space-5);
			}
			/* Page numbers are controls; the current one reads [n]. */
			.pagination {
				display: flex;
				justify-content: center;
				align-items: center;
				gap: var(--space-2);
				margin: var(--space-5) 0;
				flex-wrap: wrap;
			}
			.pagination .ellipsis {
				color: var(--secondary);
			}
		</style>
	</head>
	<body>
		<Header />
		<PageFrame title={t('blog.heading')} pattern="list">
			<ul class="post-list">
				{
					posts.map(({ post, excerpt }) => (
						<li class="post-item">
							<h2 class="post-title">
								<a href={`${blogPrefix}/${post.id}/`}>{post.data.title}</a>
							</h2>
							<div class="post-excerpt" set:html={excerpt.html} />
							<PostMeta lang={lang} pubDate={post.data.pubDate} pubDateSource={post.data.pubDateSource} author={post.data.author} category={post.data.category}>
								{excerpt.hasMore && (
									<a href={`${blogPrefix}/${post.id}/`} aria-label={`${t('blog.continueReading')} ${post.data.title}`}>
										<PixelArrowText text={t('blog.continueReading')} />
									</a>
								)}
							</PostMeta>
						</li>
					))
				}
			</ul>

			{totalPages > 1 && (
				<nav class="pagination" aria-label={t('pagination.label')}>
					{currentPage > 1 && (
						<a class="control" href={pageHref(currentPage - 1)} aria-label={t('pagination.prev')}><PixelArrowText text={t('pagination.prev')} /></a>
					)}
					{shownPages.map((page, index) => (
						<>
							{index > 0 && page - shownPages[index - 1] > 1 && <span class="ellipsis">…</span>}
							{page === currentPage
								? <span class="control" aria-current="page">[{page}]</span>
								: <a class="control" href={pageHref(page)}>{page}</a>}
						</>
					))}
					{currentPage < totalPages && (
						<a class="control" href={pageHref(currentPage + 1)} aria-label={t('pagination.next')}><PixelArrowText text={t('pagination.next')} /></a>
					)}
				</nav>
			)}
		</PageFrame>
		<Footer />
	</body>
</html>
