---
/**
 * 博客列表页 - excerpt 列表布局（含智能分页）
 * 用于首页 (/, /en/, /zh-CN/) 和分页页面 (/page/N, /en/page/N, /zh-CN/page/N)
 */
import { marked } from 'marked';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import PixelArrowText from '../components/PixelArrowText.astro';
import { getBlogPrefix, getHomePath, getHtmlLang, getPagePrefix } from '../i18n/collections';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

interface PostWithExcerpt {
	post: any;
	excerpt: { html: string; hasMore: boolean };
}

interface Props {
	lang: Lang;
	currentPage: number;
	totalPages: number;
	posts: PostWithExcerpt[];
}

const { lang, currentPage, totalPages, posts } = Astro.props;
const t = useTranslations(lang);
const htmlLang = getHtmlLang(lang);
const blogPrefix = getBlogPrefix(lang);
const pagePrefix = getPagePrefix(lang);
const homePath = getHomePath(lang);

// 页面标题
const isFirstPage = currentPage === 1;
const pageTitle = isFirstPage
	? `${SITE_TITLE} - For Coding Life`
	: t('pagination.pageTitle', { title: SITE_TITLE, page: currentPage.toString() });
---

<!doctype html>
<html lang={htmlLang}>
	<head>
		<BaseHead title={pageTitle} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: var(--page-width);
				max-width: calc(100% - var(--space-5));
				margin: auto;
				padding: var(--space-6) var(--space-3);
			}
			h1 {
				font-weight: 700;
				margin: 0 0 var(--space-5) 0;
			}
			.post-list {
				list-style-type: none;
				padding: 0;
				margin: 0 0 var(--space-6) 0;
			}
			.post-item {
				margin-bottom: var(--space-6);
				padding-bottom: var(--space-6);
				border-bottom: 1px solid #e0e0e0;
			}
			.post-item:last-child {
				border-bottom: none;
			}
			.post-title {
				font-size: var(--text-card-title);
				line-height: var(--leading-card-title);
				font-weight: 600;
				margin: 0 0 var(--space-3) 0;
			}
			.post-title a {
				color: var(--fg-primary);
				background: var(--bg-secondary);
				transition: all 0.2s ease;
				text-decoration: none;
			}
			.post-title a:hover {
				color: var(--accent);
			}
			.post-excerpt {
				color: rgb(var(--gray-dark));
				line-height: var(--leading-prose);
				margin: var(--space-3) 0;
			}
			.post-excerpt :global(blockquote) {
				margin: var(--space-3) 0;
				padding-left: var(--space-3);
				border-left: 3px solid rgb(var(--gray));
				font-style: italic;
				color: rgb(var(--gray-dark));
			}
			.post-excerpt :global(h2),
			.post-excerpt :global(h3),
			.post-excerpt :global(h4) {
				font-size: var(--text-h3);
				line-height: var(--leading-h3);
				margin: var(--space-3) 0 var(--space-2) 0;
			}
			.post-excerpt :global(p) {
				margin: var(--space-2) 0;
			}
			.post-excerpt :global(ul),
			.post-excerpt :global(ol) {
				margin: var(--space-2) 0;
				padding-left: var(--space-5);
			}
			.post-excerpt :global(code) {
				background-color: #f4f4f4;
				padding: 0.2rem 0.4rem;
				border-radius: 3px;
				font-size: var(--text-code);
				font-family: monospace;
			}
			.post-excerpt :global(pre) {
				background-color: #f4f4f4;
				padding: var(--space-3);
				overflow-x: auto;
			}
			.post-excerpt :global(pre code) {
				background-color: transparent;
				padding: 0;
			}
			.post-meta {
				display: flex;
				gap: var(--space-3);
				align-items: center;
				color: rgb(var(--gray));
				font-size: var(--text-meta);
				line-height: var(--leading-meta);
				flex-wrap: wrap;
			}
			.read-more {
				color: var(--accent);
				text-decoration: none;
				font-weight: 500;
			}
			.read-more:hover {
				text-decoration: underline;
			}
			.pagination {
				display: flex;
				justify-content: center;
				gap: var(--space-2);
				margin: var(--space-5) 0;
				flex-wrap: wrap;
			}
			.pagination a,
			.pagination span {
				padding: var(--space-2) var(--space-3);
				border: 2px solid var(--accent);
				text-decoration: none;
				color: var(--accent);
				background: transparent;
				transition: all 0.2s ease;
			}
			.pagination a:hover {
				background: var(--accent);
				color: var(--background);
			}
			.pagination .current {
				background: var(--accent);
				color: var(--background);
				font-weight: 700;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>{t('blog.heading')}</h1>
			<ul class="post-list">
				{
					posts.map(({ post, excerpt }) => (
						<li class="post-item">
							<h2 class="post-title">
								<a href={`${blogPrefix}/${post.id}/`}>{post.data.title}</a>
							</h2>
							<div class="post-excerpt" set:html={excerpt.html} />
							<div class="post-meta">
								<FormattedDate date={post.data.pubDate} source={post.data.pubDateSource} />
								{post.data.author && <span>{t('blog.authorLabel')}{post.data.author}</span>}
								{post.data.category && <span>{t('blog.categoryLabel')}{post.data.category}</span>}
								{excerpt.hasMore && (
									<a href={`${blogPrefix}/${post.id}/`} class="read-more" aria-label={`${t('blog.continueReading')} ${post.data.title}`}>
										<PixelArrowText text={t('blog.continueReading')} />
									</a>
								)}
							</div>
						</li>
					))
				}
			</ul>

			{totalPages > 1 && (
				<nav class="pagination">
					{currentPage > 1 && (
						<a href={currentPage === 2 ? homePath : `${pagePrefix}/${currentPage - 1}/`} aria-label={t('pagination.prev')}><PixelArrowText text={t('pagination.prev')} /></a>
					)}

					{/* 始终显示第1页 */}
					{currentPage === 1 ? (
						<span class="current">1</span>
					) : (
						<a href={homePath}>1</a>
					)}

					{/* 如果当前页 > 3，显示省略号 */}
					{currentPage > 3 && <span>…</span>}

					{/* 显示当前页附近的页码（当前页-1, 当前页, 当前页+1） */}
					{Array.from({ length: totalPages }, (_, i) => {
						const pageNum = i + 1;
						// 跳过第1页和最后一页（它们单独处理）
						if (pageNum === 1 || pageNum === totalPages) return null;
						// 只显示当前页附近的2页
						if (Math.abs(pageNum - currentPage) > 1) return null;

						if (pageNum === currentPage) {
							return <span class="current">{pageNum}</span>;
						}
						return <a href={`${pagePrefix}/${pageNum}/`}>{pageNum}</a>;
					})}

					{/* 如果当前页 < 总页数-2，显示省略号 */}
					{currentPage < totalPages - 2 && <span>…</span>}

					{/* 始终显示最后一页（如果总页数>1） */}
					{totalPages > 1 && (
						currentPage === totalPages ? (
							<span class="current">{totalPages}</span>
						) : (
							<a href={`${pagePrefix}/${totalPages}/`}>{totalPages}</a>
						)
					)}

					{currentPage < totalPages && (
						<a href={`${pagePrefix}/${currentPage + 1}/`} aria-label={t('pagination.next')}><PixelArrowText text={t('pagination.next')} /></a>
					)}
				</nav>
			)}
		</main>
		<Footer />
	</body>
</html>
