---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageFrame from '../components/PageFrame.astro';
import { SITE_TITLE } from '../consts';
import { useTranslations } from '../i18n/utils';

const t = useTranslations('zh');
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`${t('nav.links')} - ${SITE_TITLE}`} description={t('links.description')} />
		<style>
			.links-list {
				list-style-type: none;
				margin: 0;
			}
			.links-list li {
				margin-bottom: var(--space-3);
			}
		</style>
	</head>
	<body>
		<Header />
		<PageFrame title={t('nav.links')}>
			<article>
				<div class="prose">

					<ul class="links-list">
						<li><a href="https://moonbegonia.xyz/" target="_blank" rel="noopener noreferrer">简记</a></li>
						<li><a href="https://www.starx.ink/" target="_blank" rel="noopener noreferrer">Starx's Home</a></li>
						<li><a href="https://e11z.net/" target="_blank" rel="noopener noreferrer">Ran's Blog | 旋律的博客</a></li>
						<li><a href="https://iblog.ren/" target="_blank" rel="noopener noreferrer">星梦的小站（坂本dalao）</a></li>
						<li><a href="https://www.fxsong.xyz/" target="_blank" rel="noopener noreferrer">冯晓松的博客</a></li>
						<li><a href="https://mycroftcooper.github.io/" target="_blank" rel="noopener noreferrer">烤麸的个人学习用博客</a></li>
						<li><a href="https://limu.ltd/" target="_blank" rel="noopener noreferrer">limu</a></li>
						<li><a href="https://blog.i7arch.com/" target="_blank" rel="noopener noreferrer">Integral - An Arch Linux user, GNU/Linux and free software enthusiast.</a></li>
						<li><a href="https://blog.xbss.net/" target="_blank" rel="noopener noreferrer">小白博客</a></li>
						<li><a href="https://blog.coelacanthus.moe/" target="_blank" rel="noopener noreferrer">Coelacanthus</a></li>
						<li><a href="https://flykhan.com/" target="_blank" rel="noopener noreferrer">Flykhan</a></li>
						<li><a href="https://blog.plz.ac/" target="_blank" rel="noopener noreferrer">半瓶斋</a></li>
						<li><a href="https://gentoozh.org/zh-tw/" target="_blank" rel="noopener noreferrer">Gentoo 中文社群</a></li>
					</ul>
				</div>
			</article>
		</PageFrame>
		<Footer />
	</body>
</html>
