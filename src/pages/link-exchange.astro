---
/**
 * 友链页，画成一段终端会话：`$ ls ~/friends` 与 `$ ls ~/communities`，每项一行 `名字  主机名`
 * （名字是链接，不换行；一行放不下时主机名换到下一行），最后是带块光标的提示符。h1 只对读屏器可见，提示符行就是画面上的标题。
 */
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageFrame from '../components/PageFrame.astro';
import OutputList from '../components/term/OutputList.astro';
import Prompt from '../components/term/Prompt.astro';
import { SITE_TITLE } from '../consts';
import { useTranslations } from '../i18n/utils';

const t = useTranslations('zh');

const friends = [
	{ name: '简记', url: 'https://moonbegonia.xyz/' },
	{ name: "Starx's Home", url: 'https://www.starx.ink/' },
	{ name: "Ran's Blog | 旋律的博客", url: 'https://e11z.net/' },
	{ name: '星梦的小站（坂本dalao）', url: 'https://iblog.ren/' },
	{ name: '冯晓松的博客', url: 'https://www.fxsong.xyz/' },
	{ name: '烤麸的个人学习用博客', url: 'https://mycroftcooper.github.io/' },
	{ name: 'limu', url: 'https://limu.ltd/' },
	{ name: 'Integral - An Arch Linux user, GNU/Linux and free software enthusiast.', url: 'https://blog.i7arch.com/' },
	{ name: '小白博客', url: 'https://blog.xbss.net/' },
	{ name: 'Coelacanthus', url: 'https://blog.coelacanthus.moe/' },
	{ name: 'Flykhan', url: 'https://flykhan.com/' },
	{ name: '半瓶斋', url: 'https://blog.plz.ac/' },
];
const communities = [{ name: 'Gentoo 中文社群', url: 'https://gentoozh.org/zh-tw/' }];
const rows = (links: { name: string; url: string }[]) =>
	links.map(({ name, url }) => ({
		left: { text: name, href: url, external: true },
		right: { text: new URL(url).hostname },
	}));
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`${t('nav.links')} - ${SITE_TITLE}`} description={t('links.description')} />
	</head>
	<body>
		<Header />
		<PageFrame title={t('nav.links')} hideTitle>
			<Prompt command={t('term.friends')} />
			<OutputList rows={rows(friends)} stack label={t('links.friends')} />
			<Prompt command={t('term.communities')} />
			<OutputList rows={rows(communities)} stack label={t('links.communities')} />
			<Prompt cursor />
		</PageFrame>
		<Footer />
	</body>
</html>
