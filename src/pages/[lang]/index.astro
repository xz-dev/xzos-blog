---
import { getCollection } from 'astro:content';
import Home from '../../layouts/Home.astro';
import { getBlogCollection, nonDefaultLocales } from '../../i18n/collections';
import type { Lang } from '../../i18n/ui';

export async function getStaticPaths() {
	const paths = [];
	for (const lang of nonDefaultLocales) {
		const allPosts = (await getCollection(getBlogCollection(lang) as any)).sort(
			(a: any, b: any) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
		);
		paths.push({
			params: { lang },
			props: { lang, posts: allPosts.slice(0, 5), postCount: allPosts.length },
		});
	}
	return paths;
}

const { lang, posts, postCount } = Astro.props as { lang: Lang; posts: any[]; postCount: number };
---

<Home lang={lang} posts={posts} postCount={postCount} />
