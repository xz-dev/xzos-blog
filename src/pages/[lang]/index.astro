---
import { getCollection } from 'astro:content';
import BlogList from '../../layouts/BlogList.astro';
import { getExcerptHtml } from '../../lib/excerpt';
import { getBlogCollection, nonDefaultLocales } from '../../i18n/collections';
import type { Lang } from '../../i18n/ui';

export async function getStaticPaths() {
	const paths = [];
	for (const lang of nonDefaultLocales) {
		const allPosts = (await getCollection(getBlogCollection(lang) as any)).sort(
			(a: any, b: any) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
		);

		const postsPerPage = 10;
		const totalPages = Math.ceil(allPosts.length / postsPerPage);
		const paginatedPosts = allPosts.slice(0, postsPerPage).map((post: any) => ({
			post,
			excerpt: getExcerptHtml(post.body || ''),
		}));

		paths.push({
			params: { lang },
			props: { posts: paginatedPosts, totalPages, lang },
		});
	}
	return paths;
}

const { posts, totalPages, lang } = Astro.props as {
	posts: { post: any; excerpt: { html: string; hasMore: boolean } }[];
	totalPages: number;
	lang: Lang;
};
---

<BlogList lang={lang} currentPage={1} totalPages={totalPages} posts={posts} />
