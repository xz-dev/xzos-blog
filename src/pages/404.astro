---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PageFrame from '../components/PageFrame.astro';
import { useTranslations } from '../i18n/utils';
import { SITE_TITLE } from '../consts';

// Detect language from URL path (headers are not available on prerendered pages)
const lang = Astro.url.pathname.startsWith('/en/') ? 'en' : 'zh';
const t = useTranslations(lang);
const homeLink = lang === 'en' ? '/en/' : '/';
---

<!doctype html>
<html lang={lang === 'en' ? 'en' : 'zh-CN'}>
	<head>
		<BaseHead title={`${t('error.pageNotFound')} - ${SITE_TITLE}`} description={t('error.description')} />
	</head>
	<body>
		<Header />
		<PageFrame title={`404 ${t('error.pageNotFound')}`}>
			<p>{t('error.message')}</p>
			<p><a href={homeLink}>{t('error.backHome')}</a></p>
		</PageFrame>
		<Footer />
	</body>
</html>
