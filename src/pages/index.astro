---
import { getCollection } from 'astro:content';
import Home from '../layouts/Home.astro';
import { LS_ALL } from '../lib/xzsh';
import { getBlogCollection } from '../i18n/collections';
import type { Lang } from '../i18n/ui';

const lang: Lang = 'zh';
const allPosts = (await getCollection(getBlogCollection(lang) as any)).sort(
	(a: any, b: any) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Home lang={lang} posts={allPosts.slice(0, LS_ALL)} postCount={allPosts.length} />
